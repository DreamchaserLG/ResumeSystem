# 复制为 .env 后按需修改（docker compose 自动读取）
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume
PG_PORT=5434
REDIS_PORT=6380
API_PORT=8001

# 存储目录（挂载到容器的 /data/storage）。演示数据集用 ./showcase/storage
# STORAGE_DIR=./storage
# 演示数据集（docs/演示数据集.md）建议单独建库，避免覆盖日常数据
# POSTGRES_DB=resume_showcase

# 本地开发直连（api/worker 容器内由 compose 注入，无需设置）
# DATABASE_URL=postgresql://resume:resume@localhost:5434/resume
# REDIS_URL=redis://localhost:6380/0
# CELERY_BROKER_URL=redis://localhost:6380/1
# CELERY_RESULT_BACKEND=redis://localhost:6380/2
# STORAGE_ROOT=./storage

# 阿里云百炼（中国内地，北京）：从百炼控制台复制 API Key 填到等号后。留空时使用本地规则。
DASHSCOPE_API_KEY=
# 可选：工作空间专用 OpenAI 兼容 URL（不含 /chat/completions）
# RECRUITING_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RECRUITING_LLM_MODEL=glm-5.3
